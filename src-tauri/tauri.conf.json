{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rig Kit",
  "version": "1.0.0",
  "identifier": "com.aldhaheriza5.rigkit",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rig Kit",
        "width": 1240,
        "height": 820,
        "minWidth": 420,
        "minHeight": 500,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
